# Project ASTRA-CLEAN Ground Control Station - Environment Variables
# If running locally with backend on default port 8000:
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# If deploying to Vercel with a remote backend (e.g. Render, Railway, AWS EC2):
# NEXT_PUBLIC_BACKEND_URL=https://astra-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://astra-backend.onrender.com/ws/telemetry
